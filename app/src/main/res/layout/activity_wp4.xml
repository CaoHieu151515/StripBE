<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/strip_color">
    <ImageView
        android:layout_gravity="start"
        android:id="@+id/backButton"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/back"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="30dp"
        android:contentDescription="Back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <!-- Logo -->
    <ImageView
        android:id="@+id/centerImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/checkboxContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="24dp"/>
    <!-- Agreement Text -->

    <!-- Terms & Conditions Link -->
    <TextView
        android:id="@+id/tvAgreementText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:paddingHorizontal="20dp"
        android:text="Để bắt đầu sử dụng Chia Sẻ Chuyến Đi, trước tiên hãy đồng ý với chúng tôi"
        android:textAlignment="center"
        android:textColor="#ADFF2F"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/centerImage" />

    <TextView
        android:id="@+id/tvTermsConditions"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="Điều khoản và điều kiện"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:textAlignment="center"
        android:clickable="true"
        android:focusable="true"
        android:textAllCaps="true"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/tvAgreementText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="AllCaps" />

    <!-- Checkbox Agreement -->
    <LinearLayout
        android:id="@+id/checkboxContainer"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:gravity="center_vertical"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="@id/tvTermsConditions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginHorizontal="24dp">

        <CheckBox
            android:id="@+id/cbAgree"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#DCDCDC"
            android:paddingHorizontal="15dp"
            android:paddingVertical="20dp"
            android:buttonTint="@color/black"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tôi đồng ý với các điều khoản và điều kiện Chia Sẻ Chuyến Đi"
            android:textSize="17dp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#333"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
