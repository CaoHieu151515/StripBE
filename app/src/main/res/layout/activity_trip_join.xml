<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Back Button -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        android:src="@drawable/back_button2"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Main Split Layout -->
    <LinearLayout
        android:id="@+id/splitLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Left Column -->
        <LinearLayout
            android:id="@+id/leftColumn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardLocationInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="12dp"
                android:elevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/input_field_bg"
                    android:padding="12dp">

                    <!-- Left Icons & Line -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginEnd="12dp">

                        <!-- Pickup Icon -->
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/circle_background_container_green"
                            android:padding="6dp"
                            android:src="@drawable/arrow_circle_down"
                            app:tint="@color/gray"/>

                        <!-- Connecting Line -->
                        <View
                            android:layout_width="2dp"
                            android:layout_height="30dp"
                            android:background="@color/gray"
                            android:layout_gravity="center_horizontal"/>

                        <!-- Destination Icon -->
                        <ImageView
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/circle_background_container_green"
                            android:padding="6dp"
                            android:src="@drawable/maps_and_flags"
                            app:tint="@color/gray"/>
                    </LinearLayout>

                    <!-- Pickup & Destination Texts -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center_vertical">

                        <!-- Pickup Info -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Pickup point"
                                android:textSize="14sp"
                                android:textColor="@color/gray"/>

                            <TextView
                                android:id="@+id/tvStartLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ben Thanh Market, Ho Chi Minh City"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <!-- Destination Info -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Where to go?"
                                android:textSize="14sp"
                                android:textColor="@color/gray"/>

                            <TextView
                                android:id="@+id/tvEndLocation"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Tan Son Nhat Airport, Ho Chi Minh City"
                                android:textSize="16sp"
                                android:textColor="@color/black"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
                <!-- Card contents here (unchanged) -->
                <!-- Keep your nested LinearLayouts and views inside here -->
            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tvStopInstructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select start and end stop from the list"
                android:textSize="15sp"
                android:textStyle="bold"
                android:gravity="center"
                android:textColor="@color/gray"
                android:layout_marginStart="12dp"
                android:layout_marginTop="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerTripStops"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="12dp"/>
        </LinearLayout>

        <!-- Right Column -->
        <LinearLayout
            android:id="@+id/rightColumn"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutStartEndLoca"
                android:layout_width="match_parent"
                android:background="@drawable/input_field_bg"
                android:padding="10dp"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvStartLocaId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Start"
                    android:layout_marginLeft="20dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/btnStartLocation"
                    app:layout_constraintTop_toBottomOf="@+id/btnStartLocation"/>

                <TextView
                    android:id="@+id/tvEndLocaId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="End"
                    android:layout_marginLeft="20dp"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    app:layout_constraintStart_toStartOf="@+id/btnEndLocation"
                    app:layout_constraintTop_toBottomOf="@+id/btnEndLocation" />

                <androidx.appcompat.widget.AppCompatButton
                    android:background="@drawable/input_field_bg"
                    android:id="@+id/btnStartLocation"
                    android:layout_width="48dp"
                    android:backgroundTint="@color/Aquamarine"
                    android:layout_height="wrap_content"
                    android:text="From"
                    android:textSize="18dp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:textColor="@color/gray"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="4dp"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:background="@drawable/input_field_bg"
                    android:id="@+id/btnEndLocation"
                    android:layout_width="48dp"
                    android:layout_height="wrap_content"
                    android:text="To"
                    android:textColor="@color/gray"
                    android:textStyle="bold"
                    android:textSize="18dp"
                    android:backgroundTint="#FF6347"
                    android:textAllCaps="false"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tvStartLocaId"
                    android:layout_marginTop="4dp"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/input_field_bg"
                android:padding="8dp"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Number of Seats"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray" />
            <EditText
                android:id="@+id/etNumberOfSeats"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_field_bg"
                android:hint="Seats"
                android:paddingStart="10dp"
                android:inputType="number" />
                <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Luggage Description"
                android:textSize="15sp"
                android:textStyle="bold"
                    android:layout_marginTop="8dp"
                android:textColor="@color/gray" />
            <EditText
                android:id="@+id/etLuggageDescription"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_field_bg"
                android:hint="Description"
                android:paddingStart="10dp"
                 />
            <Button
                android:textAllCaps="false"
                android:id="@+id/btnJoinTrip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"

                android:textSize="16dp"
                android:text="Join Trip"
                android:layout_marginTop="4dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
