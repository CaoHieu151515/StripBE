<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#006A4E">

    <!-- Profile and Weather Section -->
    <LinearLayout
        android:id="@+id/profileSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_vertical">

        <!-- Profile Image -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:contentDescription="Profile Image"/>

        <!-- Name & Greeting -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desirae Levin"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginStart="8dp"/>

        <!-- Weather Section -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:gravity="end">

            <ImageView
                android:id="@+id/ivNext"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/arrow_circle_right"
                android:contentDescription="Weather Icon"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Next"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Title Text -->
    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hi Emery,\nWhere do you will go?"
        android:textSize="24sp"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:layout_marginStart="16dp"
        app:layout_constraintTop_toBottomOf="@id/profileSection"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Card for Inputs -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        android:layout_margin="16dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/titleText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical">

            <!-- Pickup Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_field_bg"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/gps"
                    android:contentDescription="Pickup Icon"/>

                <TextView
                    android:id="@+id/tvStartLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ben Thanh Market, Ho Chi Minh City"
                    android:textSize="16sp"
                    android:textColor="@color/orange"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Drop-off Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_field_bg"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/gps"
                    android:contentDescription="Drop-off Icon"/>

                <TextView
                    android:id="@+id/tvEndLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tan Son Nhat Airport, Ho Chi Minh City"
                    android:textSize="16sp"
                    android:textColor="@color/orange"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Find Drivers Button (Now inside CardView) -->
            <Button
                android:id="@+id/btnFindDrivers"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Find drivers"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="@color/green"
                android:textColor="@android:color/white"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!-- Google Map Section -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapViewOSM"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">


    </org.osmdroid.views.MapView>

</androidx.constraintlayout.widget.ConstraintLayout>
