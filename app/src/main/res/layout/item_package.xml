<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_margin="10dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_square_gray">

    <!-- Package Name -->
    <TextView
        android:id="@+id/tvPackageName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:background="@drawable/bg_container_green"
        android:padding="5dp"
        android:layout_gravity="center"
        android:text="Package Name"/>

    <!-- Row for Price and Time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="8dp"
        android:layout_gravity="center"
        android:paddingBottom="8dp">

        <!-- Price (Left) -->
        <TextView
            android:id="@+id/tvPackagePrice"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="$500"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:gravity="end"/>

        <!-- Time (Right) -->
        <TextView
            android:id="@+id/tvPackageTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="/12 hours"
            android:textSize="20sp"
            android:gravity="start"/>
    </LinearLayout>

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Per month billed monthly. Billing starts after the 14-day free trial"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_gravity="center"/>
    <!-- Button Below Description -->
    <Button
        android:id="@+id/btnSubscribe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mua gói ngay bây giờ"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginLeft="50dp"
        android:layout_marginRight="50dp"
        android:backgroundTint="@color/orange"
        android:textColor="@android:color/white"
        android:layout_marginTop="10dp"/>
    <!-- Bonus -->
    <TextView
        android:id="@+id/tvBonus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/checked"
        android:drawablePadding="5dp"
        android:text="Bonus: 30 days"
        android:layout_gravity="center"
        android:textSize="18sp"/>

    <!-- Status -->
    <TextView
        android:id="@+id/tvPackageStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: ACTIVE"
        android:drawableStart="@drawable/checked"
        android:drawablePadding="5dp"
        android:layout_gravity="center"
        android:textSize="18sp"/>

</LinearLayout>
