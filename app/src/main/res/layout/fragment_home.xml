<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- Profile Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Left Image -->
                <ImageView
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@drawable/logo"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_square_gray"
                    android:layout_marginEnd="10dp"/>

                <!-- Center Text -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xin chào bạn"
                    android:textSize="18sp"
                    android:textStyle="bold"/>


            </LinearLayout>
            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_square_gray"
                android:padding="3dp"
                android:layout_marginTop="16dp">

                <EditText
                    android:id="@+id/edFindByLocation"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="48dp"
                    android:hint="Tìm kiếm theo địa điểm"
                    android:drawableStart="@drawable/search"
                    android:drawablePadding="5dp"
                    android:textSize="14sp"
                    android:layout_marginLeft="3dp"
                    android:background="@null"/>
                <ImageView
                    android:id="@+id/ivSearchLocation"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/filters"
                    android:padding="3dp"
                    android:layout_marginRight="3dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_square"/>
            </LinearLayout>

            <!-- Travel Places Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Địa điểm du lịch"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>



            <!-- Featured Places -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginTop="16dp">

                <!-- FrameLayout to overlay text on Image -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:background="@drawable/bg_square_gray"
                    android:layout_height="wrap_content">

                    <!-- Image -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/trip"/>

                    <!-- Text Content (Overlayed) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_gravity="bottom"
                        android:paddingVertical="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edinburgh"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scotland"
                            android:textSize="15sp"
                            android:textColor="@color/Gray"/>
                    </LinearLayout>
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Khám phá các địa điểm"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp"/>
            <TextView
                android:id="@+id/tvLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="18sp"
                android:visibility="visible"
                android:layout_gravity="center"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewTrips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="horizontal"
                android:layout_marginTop="16dp"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>