
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F8FF">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardLocationInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="12dp"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Left Icons & Line -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginEnd="12dp">

                <!-- Pickup Icon -->
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/circle_background_container_green"
                    android:src="@drawable/arrow_circle_down"
                    android:padding="6dp"
                    app:tint="@color/gray"/>

                <!-- Connecting Line -->
                <View
                    android:layout_width="2dp"
                    android:layout_height="30dp"
                    android:background="@color/gray"
                    android:layout_gravity="center_horizontal"/>

                <!-- Destination Icon -->
                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/circle_background_container_green"
                    android:padding="6dp"
                    android:src="@drawable/maps_and_flags"
                    app:tint="@color/gray"/>
            </LinearLayout>

            <!-- Pickup & Destination Texts -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <!-- Pickup Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pickup point"
                        android:textSize="14sp"
                        android:textColor="@color/gray"/>

                    <TextView
                        android:id="@+id/tvStartLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ben Thanh Market, Ho Chi Minh City"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>
                </LinearLayout>

                <!-- Destination Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Where to go?"
                        android:textSize="14sp"
                        android:textColor="@color/gray"/>

                    <TextView
                        android:id="@+id/tvEndLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tan Son Nhat Airport, Ho Chi Minh City"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Google Map View -->
    <org.osmdroid.views.MapView
        android:layout_margin="16dp"
        android:id="@+id/mapViewOSM"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/cardLocationInfo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Ride Selection Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRideSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/mapViewOSM"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvChooseRide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose a ride"
            android:textSize="16sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:textColor="@color/black"
            android:textStyle="bold"/>

        <!-- RecyclerView for Ride Options -->
        <androidx.recyclerview.widget.RecyclerView
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:id="@+id/recyclerRideOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"/>
    </androidx.cardview.widget.CardView>

    <!-- Order Now Button -->
    <Button
        android:id="@+id/btnOrderNow"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="Order now - $23.87"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/green"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:layout_margin="16dp"
        app:layout_constraintTop_toBottomOf="@id/cardRideSelection"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
