<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#006A4E">

    <!-- Profile and Weather Section -->
    <LinearLayout
        android:id="@+id/profileSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:gravity="end">

            <ImageView
                android:id="@+id/ivExit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/rectangle_xmark" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/contaner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/profileSection"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="MissingConstraints">

        <!-- Button with label on the left -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingEnd="8dp">
            <TextView
                android:id="@+id/titleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chào bạn,\nBạn muốn đi đâu?"
                android:textSize="24sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginStart="10dp"
                />
        </LinearLayout>

        <!-- Distance & Duration on the right -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:layout_marginEnd="10dp"
            android:gravity="center">

            <!-- Distance column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvDistanceLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khoảng cách"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:id="@+id/tvDistanceValue"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="-- km"
                    android:gravity="center"
                    android:background="@drawable/input_field_bg"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black" />
            </LinearLayout>

            <!-- Duration column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginLeft="5dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tvDurationLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Khoảng thơi gian"
                    android:textSize="17sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginBottom="5dp" />

                <TextView
                    android:id="@+id/tvDurationValue"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="-- mins"
                    android:gravity="center"
                    android:background="@drawable/input_field_bg"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/black" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!-- Title Text -->


    <!-- Card for Inputs -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        android:layout_margin="16dp"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/contaner"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="vertical">

            <!-- Pickup Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_field_bg"
                android:padding="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="@drawable/circle_background_container_green"
                    android:src="@drawable/arrow_circle_down"
                    android:contentDescription="Pickup Icon"/>

                <EditText
                    android:id="@+id/etStartLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:background="@drawable/input_field_no_bg"
                    android:hint="Nhập điểm bắt đầu"
                    android:textSize="18sp"
                    android:textColor="@color/gray"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Drop-off Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/input_field_bg"
                android:padding="12dp"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="10dp"
                    android:background="@drawable/circle_background_container_green"
                    android:src="@drawable/maps_and_flags"
                    android:contentDescription="Drop-off Icon"/>

                <EditText
                    android:id="@+id/etEndLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:hint="Nhập điểm kết thúc"
                    android:textSize="18sp"
                    android:background="@drawable/input_field_no_bg"
                    android:textColor="@color/gray"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <!-- Find Drivers Button (Now inside CardView) -->
            <Button
                android:id="@+id/btnSearchLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Tìm kiếm địa điểm"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:backgroundTint="@color/green"
                android:textColor="@android:color/white"
                android:layout_marginTop="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <!-- Google Map Section -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapViewOSM"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_margin="16dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/cardInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </org.osmdroid.views.MapView>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="5dp"
        android:layout_margin="12dp"
        app:layout_constraintTop_toBottomOf="@id/mapViewOSM">
        <Button
            android:id="@+id/btnChooseLocation"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:textSize="17dp"
            android:textAllCaps="false"
            android:backgroundTint="@color/azure"
            android:text="Chọn địa điểm"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
