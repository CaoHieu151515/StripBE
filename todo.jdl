enum DriverStatus {
  ACTIVE,
  BANNED,
  NOT_DRIVER,
  CONFIRMING
}

enum VehicleType {
  CAR,
  BIKE
}

enum VehicleStatus{
  ACTIVE,
  INACTIVE,
  CONFIRMING,
  REJECTED
}

enum TripStatus {
  UPCOMING,
  CONFIRMING,
  ON_GOING,
  DONE,
  RESEND,
  CANCEL,
  REJECTED
}

enum FeedbackStatus {
  WAITING,
  DONE
}

enum PassengerStatus {
    WAITING,
    BOOKED,
    DONE,
    EMPTY,
    CANCEL,
    REJECTED
}

enum FeedbackType {
  DRIVER_TO_USER,
  USER_TO_DRIVER
}

enum ReportType {
  DRIVER_TO_USER,
  USER_TO_DRIVER
}

enum RatingType {
  DRIVER_TO_USER,
  USER_TO_DRIVER
}

enum PaymentStatus {
  PENDING,
  SUCCESS,
  FAILED,
  CANCEL
}

enum TransactionStatus {
  PENDING,
  SUCCESS,
  FAILED
}

enum ReportStatus {
  WAITING,
  DONE
}

enum ApplicationType {
	FEEDBACKSYSTEM,
    REPORTBUG,
    REPORTDRIVER

}

enum PassengerType{
	 LUGGAGE,
     PASSENGER

}

enum DriverPointHistoryStatus{
  DONE,
  REFUND
}

enum WalletTransactionType{
    DEPOSIT, //User nap tiền
    WITHDRAW, // user rút tiền
    REFUND, // tiền refund
    DRIVER_CREATE_TRIP_FEE, // phí driver tạo trip
    DRIVER_DONE_TRIP_REFUND, // sau khi hoàn thành chuyến đi thì trả lại cho driver
    DRIVER_DONE_TRIP_FEE, // số tiền cuối cùng hệ thống nhận được của chuyến đi = tổng số ghế được đặt
    PASSENGER_APPROVE_FEE, // số tiền passenger cọc trước đặt chổ 
    SYSTEM_GAIN_CREATE_TRIP_FEE, // tiện hệ thống nhận khi create trip
    SYSTEM_GAIN_PASSENGER_APPROVE_FEE, // tiền hệ thống giữ khi pass senger approve chuyến
    SYSTEM_GAIN_DONE_TRIP_FEE, // Số tiền hệ thống nhận sau khi chuyến hoàn thành
    DRIVER_BUY_PACKAGE, // tài xế mua package
    SYSTEM_GAIN_PACKAGE_FEE // Tiền hệ thống nhận khi driver mua package
}

enum PackageDriverStatus{
    ACTIVE,
    EXPIRED,
    CANCEL
}

entity DriverPointHistory {
  pointId UUID,
  point Integer,
  reason String,
  date Instant,
  status DriverPointHistoryStatus
}

entity Driver {
  driverID UUID,
  usedtoDriver Boolean,
  expirationDate Instant,
  driverStatus DriverStatus,
  driverPoint Integer,
  bannedDay Instant,
  driverLicense Blob,
  identityCardFaceUp Blob,
  identityCardFacedown Blob

}

entity Vehicle {
  vehicleID UUID,
  vehicleType VehicleType,
  vehicleImage Blob ,
  carregistration Blob,
  vehicleInspectionCertificate Blob,
  carInsurance Blob,
  vehicleNumber String,
  numberOfSeats Integer,
  vehicleColor String,
  vehicleBrand String,
  status VehicleStatus
}

entity Trip {
  tripID UUID,
  tripImg Blob,
  pricePerSeat Double,
  maxSeat Integer,
  totalTime Integer,
  totalDistance Double,
  startDate Instant,
  endDate Instant,
  currentSeat Integer,
  startLocation String,
  endLocation String,
  description String,
  condition String,
  cancelReason String,
  tripStatus TripStatus
}

entity TripStopLocation {
  stopLocaID UUID,
  stopLoca String,
  stoplocaPosition Integer,
  estimatedTime Integer,
  estimatedKM Double,
  stopLocaTime Instant,
  stopLocaStatus String
}

entity RequestTrip {
  requestTripID UUID,
  startLoca String,
  endLoca String,
  amountApproveFee Double,
  numberofSeats Integer,
  luggageImg Blob,
  luggageDescription String,
  type PassengerType,
  status PassengerStatus,
  pickUpTime Instant,
  endTime Instant,
  checkIn Boolean,
  checkInTime Instant,
  checkOut Boolean,
  checkOutTIme  Instant,
  appliedAt Instant
}

entity Feedback {
  feedbackID UUID,
  feedbackType FeedbackType,
  feedbackDescription String,
  feedbackRating Integer,
  feedbackStatus FeedbackStatus
}

entity Rating {
  ratingID UUID,
  ratingTime Instant,
  ratingDriver Integer,
  ratingType RatingType
}

entity PackageDriver {
  packageID UUID,
  price Double,
  name String,
  description String,
  time Integer,
  bonus Integer,
  status PackageDriverStatus
}

entity Payment {
  paymentID UUID,
  amount Double,
  paymentDate Instant,
  paymentStatus PaymentStatus,
  transactionId String
}

entity Notification {
  date Instant,
  content String
}

entity Report {
  reportID UUID,
  reportType ReportType,
  date Instant,
  content String,
  reportStatus ReportStatus
}

entity SystemWallet{
	systemWalletID UUID,
    before Double,
    amount Double,
    current Double,
    blockAmount Double,
    mobifyDate Instant

}

entity WalletTransaction
{
	transID UUID,
	amount Double,
    date Instant,
    walletType WalletTransactionType,
    transStatus TransactionStatus,
    transactionThirdPartyID String

}

entity SendingAplication{
	apliID UUID,
    sendApplicationType ApplicationType,
    content String,
	img Blob

}

entity UserWallet{
	userWallet UUID,
    before Double,
    amount Double,
    current Double,
    mobifyDate Instant

}

entity WalletDeposit {
  id UUID,
  bankNumber String,
  nameOfBank String,
  bank String,
  amount Double,
  date Instant,
  status PaymentStatus
}


entity UserDetail{
	appUserDetail UUID,
    userimage Blob,
    phone String,
    gender String,
    address String,
    dob Instant
}

entity DriverPackageSubscription {
  id UUID,
  purchaseDate Instant,
  expirationDate Instant,
  packagePrice Double,
  active Boolean
}




relationship OneToOne {
  UserDetail to User with builtInEntity,
  Driver to User with builtInEntity,
  UserWallet to User with builtInEntity
}



relationship ManyToOne {
  DriverPointHistory to Driver,
  DriverPointHistory to UserDetail,
  Vehicle to Driver,
  Trip to Vehicle,
  Trip to Driver,
  RequestTrip to Trip,
  RequestTrip to User with builtInEntity,
  TripStopLocation to Trip,
  Feedback to Trip,
  Feedback to Driver,
  Feedback to User with builtInEntity,
  Report to Trip,
  Report to Driver,
  Report to User with builtInEntity,
  Rating to Trip,
  Rating to Driver,
  Rating to User with builtInEntity,
  Payment to User with builtInEntity,
  Payment to PackageDriver,
  Notification to User with builtInEntity,
  WalletTransaction to SystemWallet,
  WalletTransaction to Payment,
  SendingAplication to User with builtInEntity,
  WalletTransaction to UserWallet,
  WalletDeposit to UserWallet,
  DriverPackageSubscription to Driver,
  DriverPackageSubscription to PackageDriver
}

paginate Driver, Vehicle, Trip, TripStopLocation, RequestTrip, Feedback, PackageDriver, Payment, Notification, Report, DriverPointHistory with pagination
service Driver, Vehicle, Trip, TripStopLocation, RequestTrip, Feedback, PackageDriver, Payment, Notification, Report, DriverPointHistory with serviceClass
dto Driver, Vehicle, Trip, TripStopLocation, RequestTrip, Feedback, PackageDriver, Payment, Notification, Report with mapstruct

